{
  "manifest_version": "0.4",
  "name": "neuraliquid-mcp",
  "display_name": "NeuraLiquid Signals by FutureCast",
  "description": "Inspect, buy or resume a budget-limited agent pass and read watchlist events.",
  "version": "1.1.0",
  "author": {
    "name": "FutureCast"
  },
  "homepage": "https://github.com/Marcolist/neuraliquid-mcp",
  "server": {
    "type": "uv",
    "entry_point": "neuraliquid_mcp.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "neuraliquid_mcp.py"
      ]
    }
  },
  "keywords": [
    "x402",
    "crypto signals",
    "watchlist",
    "Base",
    "USDC"
  ]
}
